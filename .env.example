RECALLOPS_DATABASE_URL=postgresql://root@localhost:26257/recallops?sslmode=disable
RECALLOPS_STORE=postgres
RECALLOPS_AWS_REGION=us-east-1
RECALLOPS_REASONING_PROVIDER=deterministic
RECALLOPS_EMBEDDING_PROVIDER=deterministic
RECALLOPS_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
RECALLOPS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
RECALLOPS_EVIDENCE_BUCKET=
RECALLOPS_EVIDENCE_VERIFIER=manual_only
RECALLOPS_LOG_LEVEL=INFO
RECALLOPS_PROVIDER_CONNECT_TIMEOUT_SECONDS=2
RECALLOPS_PROVIDER_READ_TIMEOUT_SECONDS=15
RECALLOPS_PROVIDER_MAX_ATTEMPTS=3
RECALLOPS_DATABASE_CONNECT_TIMEOUT_SECONDS=5
RECALLOPS_DATABASE_STATEMENT_TIMEOUT_SECONDS=15
RECALLOPS_RETRIEVAL_CANDIDATE_MULTIPLIER=8
RECALLOPS_DEFAULT_COMPATIBILITY_POLICY=exact
RECALLOPS_COMPATIBILITY_POLICY_VERSION=semver-v1
RECALLOPS_DIAGNOSTIC_PROVIDER=none
# Required when provider=aws; only deployment-owned prefixes are accepted.
# RECALLOPS_DIAGNOSTIC_ALARM_PREFIX=recallops
# RECALLOPS_DIAGNOSTIC_ECS_CLUSTER=recallops
# RECALLOPS_DIAGNOSTIC_ECS_SERVICE_PREFIX=recallops
RECALLOPS_DIAGNOSTIC_MAX_ALARMS=5
RECALLOPS_DIAGNOSTIC_MAX_DEPLOYMENTS=5
RECALLOPS_OUTBOX_MAX_ATTEMPTS=8
RECALLOPS_OUTBOX_LEASE_SECONDS=120
RECALLOPS_AUTH_MODE=demo
RECALLOPS_PUBLIC_ORIGIN=http://127.0.0.1:8000
# Judge mode accepts SHA-256 digests only. Keep raw bootstrap codes and the HMAC key in a secret
# manager; provide role-specific links through judge-only instructions.
RECALLOPS_JUDGE_TENANT_ID=judge
RECALLOPS_JUDGE_OPERATOR_BOOTSTRAP_SHA256=
RECALLOPS_JUDGE_REVIEWER_BOOTSTRAP_SHA256=
RECALLOPS_JUDGE_RATE_LIMIT_KEY=
RECALLOPS_JUDGE_SESSION_TTL_SECONDS=3600
RECALLOPS_JUDGE_EXCHANGE_ATTEMPT_LIMIT=8
RECALLOPS_JUDGE_EXCHANGE_WINDOW_SECONDS=300
RECALLOPS_JUDGE_COOKIE_SECURE=true
RECALLOPS_OIDC_ISSUER=
RECALLOPS_OIDC_AUDIENCE=
RECALLOPS_OIDC_TENANT_CLAIM=tenant_id
RECALLOPS_OIDC_ROLES_CLAIM=cognito:groups
RECALLOPS_OIDC_LEEWAY_SECONDS=30
RECALLOPS_OIDC_MAX_TOKEN_AGE_SECONDS=3700
